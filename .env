POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=stt_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://user:password@postgres:5432/stt_db
DATABASE_ASYNC_URL=postgresql+asyncpg://user:password@postgres:5432/stt_db

RABBIT_HOST=amqp://guest:guest@rabbitmq:5672/

S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_S3_BUCKET=generate-protocol
S3_REGION=us-east-1

# Локальное хранилище
TMP_DIR=/worker/tmp